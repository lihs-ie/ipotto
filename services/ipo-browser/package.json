{
  "name": "ipo-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"import('node:fs/promises').then(async (fs) => { await fs.mkdir('dist/config', { recursive: true }); await fs.copyFile('src/config/selectors.yaml', 'dist/config/selectors.yaml'); })\"",
    "start": "node dist/index.js",
    "test": "vitest",
    "e2e": "playwright test",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@ipotto/shared": "workspace:*",
    "express": "^5.2.0",
    "googleapis": "^171.0.0",
    "imapflow": "^1.0.184",
    "js-yaml": "^4.1.0",
    "mailparser": "^3.7.4",
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.5",
    "eslint": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
